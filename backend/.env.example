PORT=3000
JWT_SECRET=ganti_dengan_teks_acak_yang_panjang_minimal_32_karakter

# Midtrans Sandbox (Dashboard sandbox -> Settings -> Access Keys). Kosong = "demo order" (butuh ALLOW_DEV_ROUTES=true)
MIDTRANS_SERVER_KEY=

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Nama model Gemini (cek daftar model di AI Studio bila error 404)
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Spotify Developer Dashboard -> Create app -> Client ID & Client Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# openweathermap.org -> API keys (free plan cukup)
OPENWEATHER_API_KEY=

# true = aktifkan endpoint demo (simulate payment, tamper blockchain, broadcast promo). Matikan saat production.
ALLOW_DEV_ROUTES=true
